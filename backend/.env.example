# ── MongoDB Connection ────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio

# ── Frontend CORS Allowed Origins ──────────────────────────────────────────────
# Comma-separated list of origins or FRONTEND_URL
CORS_ORIGINS=https://rana-summar-0.vercel.app,http://localhost:3000
FRONTEND_URL=https://rana-summar-0.vercel.app

# ── Gmail SMTP Credentials (for Contact Form) ──────────────────────────────────
# Note: GMAIL_APP_PASSWORD must be a 16-character App Password generated in Google Account settings
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
